DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USER=postgres
DB_PASSWORD=supersecret
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ENV=TEST
SKIP_MICROSOFT_SIGN_IN=true

# Both are REQUIRED when ENV=TEST — the app exits at startup without them (MCO-332).
# APP_HOST drives the OAuth redirect_uri and the auth-cookie domain; PREVIEW_PASSWORD gates
# the preview behind HTTP Basic Auth.
APP_HOST=localhost:8080
PREVIEW_PASSWORD=preview

# Demo sign-in identity. No default since MCO-333 — unset means demo sign-in is off.
DEMO_USER=demo-user
