FROM eclipse-temurin:25-jre-alpine

EXPOSE "8080:8080"

RUN mkdir /app

COPY *-with-dependencies.jar /app/mcorg.jar

ENTRYPOINT ["java", "-Xms256m", "-Xmx768m", "-jar", "/app/mcorg.jar"]

# No HEALTHCHECK here on purpose — Fly Machines does not run the Docker directive. See the note
# in Dockerfile and `[[http_service.checks]]` in dev.fly.toml (MCO-349).
